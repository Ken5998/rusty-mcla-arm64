+/// The sound card: rodio's own stream (it asks ALSA for 100 ms), or with MCLA_AUDIO_BUFFER=<frames>
+/// rodio's mixer played through a cpal stream of the game's own with that buffer, for a shorter delay
+/// (a device that refuses it takes rodio's stream). Not the default: on the Retroid Pocket 6 through
+/// PipeWire a 1024-frame stream opened without error and played nothing.
+#[allow(dead_code)] // (the streams are held only to keep them playing)
+enum Out {
+    Rodio(OutputStream, OutputStreamHandle),
+    Own(Arc<rodio::dynamic_mixer::DynamicMixerController<f32>>, rodio::cpal::Stream),
+}
+
+impl Out {
+    fn open() -> Option<Out> {
+        let frames = std::env::var("MCLA_AUDIO_BUFFER").ok().and_then(|v| v.trim().parse::<u32>().ok()).unwrap_or(0);
+        if frames > 0 {
+            match Self::own(frames) {
+                Ok(out) => return Some(out),
+                Err(e) => log::warn!("audio: no {frames}-frame output stream ({e}), rodio's own"),
+            }
+        }
+        let (stream, handle) = OutputStream::try_default().ok()?;
+        Some(Out::Rodio(stream, handle))
+    }
+
+    fn own(frames: u32) -> Result<Out, String> {
+        use rodio::cpal::traits::{HostTrait, StreamTrait};
+        use rodio::DeviceTrait;
+        let device = rodio::cpal::default_host().default_output_device().ok_or("no output device")?;
+        let def = device.default_output_config().map_err(|e| e.to_string())?;
+        if def.sample_format() != rodio::cpal::SampleFormat::F32 {
+            return Err(format!("{:?} samples", def.sample_format()));
+        }
+        let frames = match def.buffer_size() {
+            rodio::cpal::SupportedBufferSize::Range { min, max } => frames.clamp(*min, *max),
+            rodio::cpal::SupportedBufferSize::Unknown => frames,
+        };
+        let config = rodio::cpal::StreamConfig { channels: def.channels(), sample_rate: def.sample_rate(), buffer_size: rodio::cpal::BufferSize::Fixed(frames) };
+        let (mixer, mut rx) = rodio::dynamic_mixer::mixer::<f32>(config.channels, config.sample_rate.0);
+        let stream = device
+            .build_output_stream::<f32, _, _>(&config, move |data, _| data.iter_mut().for_each(|d| *d = rx.next().unwrap_or(0.0)), {
+                // (said once: a stream that fails keeps failing on every period)
+                let said = std::sync::atomic::AtomicBool::new(false);
+                move |e| {
+                    if !said.swap(true, std::sync::atomic::Ordering::Relaxed) {
+                        log::warn!("audio: output stream: {e} (further errors not logged)");
+                    }
+                }
+            }, None)
+            .map_err(|e| e.to_string())?;
+        stream.play().map_err(|e| e.to_string())?;
+        log::info!("audio: output {} Hz, {} channels, buffer {frames} frames ({:.0} ms)", config.sample_rate.0, config.channels, frames as f32 * 1000.0 / config.sample_rate.0 as f32);
+        Ok(Out::Own(mixer, stream))
+    }
+
+    fn sink(&self) -> Result<Sink, rodio::PlayError> {
+        match self {
+            Out::Rodio(_, handle) => Sink::try_new(handle),
+            Out::Own(mixer, _) => {
+                let (sink, queue) = Sink::new_idle();
+                mixer.add(queue);
+                Ok(sink)
+            }
+        }
+    }
+}
