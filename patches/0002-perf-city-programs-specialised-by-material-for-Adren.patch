diff --git a/mcla-rs/crates/game/src/render/cityspec.rs b/mcla-rs/crates/game/src/render/cityspec.rs
new file mode 100644
index 0000000..31dd37c
--- /dev/null
+++ b/mcla-rs/crates/game/src/render/cityspec.rs
@@ -0,0 +1,262 @@
+//! The city programs specialised by material, for GPUs that pay for the size of a program.
+//!
+//! city.wgsl is one fragment program for every material: `mat.mode` picks the branch at run time.
+//! On a desktop GPU that costs little. On an Adreno (Turnip's compiler, ir3) the whole program is
+//! one block of ~21 000 instructions at the register file's limit (48 registers, 4 waves), and the
+//! city pass took 370 ms a frame on an Adreno 740. The same text with the mode a constant compiles
+//! to 2 500 - 5 500 instructions in 16 - 24 registers (8 - 12 waves).
+//!
+//! So each (pipeline, material) pair gets its own pipeline, built from the same text with
+//! `mat.mode` fixed: on first use it is queued for worker threads and the shared pipeline draws
+//! until it is ready, so nothing waits for the compiler. The draw sites set the city pipelines with
+//! [`super::Gpu::set_city`] and bind materials with [`super::Gpu::bind_mat`], which swaps in the
+//! material's own pipeline; anything else that binds a material (the shadow passes) calls
+//! [`super::Gpu::city_off`] first. MCLA_CITY_SPEC=0: the shared pipelines only, as upstream.
+//! Each pipeline is per [`super::ms::Variant`] too (the scene's sample count), like the shared ones, and the
+//! current city pipeline is kept per thread, since the city pass is recorded on two threads.
+//!
+//! A draw with the shared pipeline costs as much as the whole city did, so the frame it falls in
+//! can take a quarter of a second. The pairs drawn once are kept in `city-programs.txt` in the
+//! user folder and queued at the next start, before anything asks for them (Mesa's shader cache
+//! makes those quick); a pair the frame asks for goes to the front of the queue.
+
+use super::{ms, post, Vertex};
+use hashbrown::{HashMap, HashSet};
+use std::collections::VecDeque;
+use std::io::Write;
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Arc, Condvar, Mutex};
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub enum CityKind {
+    Opaque,
+    Blend,
+    GlassBack,
+    GlassFront,
+    GlassInner,
+    Pane,
+    EnvDp,
+    EnvDpBlend,
+    Inst,
+    InstBlend,
+}
+
+const KINDS: [CityKind; 10] = [
+    CityKind::Opaque,
+    CityKind::Blend,
+    CityKind::GlassBack,
+    CityKind::GlassFront,
+    CityKind::GlassInner,
+    CityKind::Pane,
+    CityKind::EnvDp,
+    CityKind::EnvDpBlend,
+    CityKind::Inst,
+    CityKind::InstBlend,
+];
+
+/// (kind, material, the variant's slot: ms::Variant::slot)
+type Key = (CityKind, u32, usize);
+
+fn variant_of(slot: usize) -> ms::Variant {
+    match slot {
+        0 => ms::PLAIN,
+        1 => ms::scene(1),
+        2 => ms::scene(2),
+        _ => ms::scene(4),
+    }
+}
+
+thread_local! {
+    static CUR: Cell<Option<CityKind>> = const { Cell::new(None) };
+}
+
+struct Shared {
+    device: wgpu::Device,
+    layout: wgpu::PipelineLayout,
+    src: String,
+    glass_flip: bool,
+    ready: Mutex<HashMap<Key, wgpu::RenderPipeline>>,
+    queue: Mutex<VecDeque<Key>>,
+    wake: Condvar,
+    building: AtomicU32,
+}
+
+pub struct CitySpec {
+    shared: Option<Arc<Shared>>,
+    asked: Mutex<HashSet<Key>>,
+}
+
+fn list_path() -> std::path::PathBuf {
+    mcla_config::paths::user_data_dir().join("city-programs.txt")
+}
+
+/// The pipelines drawn in earlier games: lines of "<kind number> <material> <variant slot>".
+fn drawn_before() -> Vec<Key> {
+    let text = std::fs::read_to_string(list_path()).unwrap_or_default();
+    text.lines()
+        .filter_map(|l| {
+            let mut it = l.split_whitespace();
+            let k = KINDS.get(it.next()?.parse::<usize>().ok()?)?;
+            let m = it.next()?.parse::<u32>().ok().filter(|m| *m < super::MatMode::COUNT)?;
+            let v = it.next()?.parse::<usize>().ok().filter(|v| *v < 4)?;
+            Some((*k, m, v))
+        })
+        .collect()
+}
+
+fn remember((kind, mode, slot): Key) {
+    let k = KINDS.iter().position(|x| *x == kind).unwrap();
+    let path = list_path();
+    let _ = std::fs::create_dir_all(path.parent().unwrap_or(&path));
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+        let _ = writeln!(f, "{k} {mode} {slot}");
+    }
+}
+
+/// The program text without the diagnostics views when MCLA_DEBUG_VIEW is not set: `g.params.w`
+/// is that variable's number and 0 otherwise, so the compiler can drop the ~230 branches that test it.
+pub fn without_debug_views(src: String) -> String {
+    if std::env::var("MCLA_DEBUG_VIEW").is_ok() {
+        return src;
+    }
+    format!("var<private> debug_view_off: f32 = 0.0;\n{}", src.replace("g.params.w", "debug_view_off"))
+}
+
+fn specialised(src: &str, mode: u32) -> String {
+    format!("var<private> mat_mode_fixed: u32 = {mode}u;\n{}", src.replace("mat.mode", "mat_mode_fixed"))
+}
+
+impl CitySpec {
+    pub fn new(device: &wgpu::Device, layout: &wgpu::PipelineLayout, src: &str, glass_flip: bool) -> CitySpec {
+        let on = std::env::var("MCLA_CITY_SPEC").map_or(true, |v| v.trim() != "0");
+        log::info!("city programs by material: {}", if on { "on" } else { "off (MCLA_CITY_SPEC=0)" });
+        let shared = on.then(|| {
+            Arc::new(Shared {
+                device: device.clone(),
+                layout: layout.clone(),
+                src: src.to_string(),
+                glass_flip,
+                ready: Mutex::new(HashMap::new()),
+                queue: Mutex::new(VecDeque::new()),
+                wake: Condvar::new(),
+                building: AtomicU32::new(0),
+            })
+        });
+        let mut asked = HashSet::new();
+        if let Some(shared) = shared.as_ref() {
+            let before = drawn_before();
+            let mut q = shared.queue.lock().unwrap();
+            for pair in before {
+                if asked.insert(pair) {
+                    q.push_back(pair);
+                }
+            }
+            log::info!("city programs: {} drawn in earlier games, built in the background", q.len());
+            drop(q);
+            for n in 0..3 {
+                let shared = shared.clone();
+                let _ = std::thread::Builder::new().name(format!("city programs {n}")).spawn(move || loop {
+                    let key = {
+                        let mut q = shared.queue.lock().unwrap();
+                        loop {
+                            if let Some(job) = q.pop_front() {
+                                shared.building.fetch_add(1, Ordering::Relaxed);
+                                break job;
+                            }
+                            q = shared.wake.wait(q).unwrap();
+                        }
+                    };
+                    let t = std::time::Instant::now();
+                    let p = build(&shared, key);
+                    log::debug!("city program {key:?}: {:.0} ms", t.elapsed().as_secs_f32() * 1000.0);
+                    shared.ready.lock().unwrap().insert(key, p);
+                    shared.building.fetch_sub(1, Ordering::Relaxed);
+                });
+            }
+        }
+        CitySpec { shared, asked: Mutex::new(asked) }
+    }
+
+    /// The city pipeline this thread's pass is drawing with (None: not a city one).
+    pub fn set_cur(&self, kind: Option<CityKind>) {
+        CUR.with(|c| c.set(kind));
+    }
+
+    pub fn cur(&self) -> Option<CityKind> {
+        CUR.with(|c| c.get())
+    }
+
+    /// The material's own pipeline when it is built; else it goes to the front of the queue and `None`.
+    pub fn get(&self, kind: CityKind, mode: u32) -> Option<wgpu::RenderPipeline> {
+        let shared = self.shared.as_ref()?;
+        // (the environment map's pipelines are plain only; the rest follow the frame's variant, as ms::MsPipe)
+        let slot = if matches!(kind, CityKind::EnvDp | CityKind::EnvDpBlend) { 0 } else { ms::current().slot() };
+        let key = (kind, mode, slot);
+        if let Some(p) = shared.ready.lock().unwrap().get(&key) {
+            return Some(p.clone());
+        }
+        let new = self.asked.lock().unwrap().insert(key);
+        let mut q = shared.queue.lock().unwrap();
+        if new {
+            remember(key);
+            q.push_front(key);
+            shared.wake.notify_one();
+        } else if let Some(i) = q.iter().position(|x| *x == key).filter(|i| *i > 0) {
+            q.remove(i);
+            q.push_front(key);
+        }
+        None
+    }
+}
+
+fn build(s: &Shared, (kind, mode, slot): Key) -> wgpu::RenderPipeline {
+    let v = variant_of(slot);
+    use CityKind::*;
+    let module = s.device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: Some("city (one material)"),
+        source: wgpu::ShaderSource::Wgsl(specialised(&s.src, mode).into()),
+    });
+    // (the same states as render/mod.rs gives the shared pipelines: city_build, pipeline_inst*)
+    let (back, front) = if s.glass_flip { (wgpu::Face::Back, wgpu::Face::Front) } else { (wgpu::Face::Front, wgpu::Face::Back) };
+    let (vs, blend, cull, zwrite) = match kind {
+        Opaque => ("vs_main", false, None, true),
+        Blend => ("vs_main", true, None, false),
+        GlassBack => ("vs_main", true, Some(back), true),
+        GlassFront => ("vs_main", true, Some(front), true),
+        GlassInner => ("vs_main", true, Some(back), false),
+        Pane => ("vs_main", true, None, true),
+        EnvDp => ("vs_env_dp", false, None, true),
+        EnvDpBlend => ("vs_env_dp", true, None, false),
+        Inst => ("vs_inst", false, None, true),
+        InstBlend => ("vs_inst", true, None, false),
+    };
+    let inst = matches!(kind, Inst | InstBlend);
+    let bufs_plain = [Vertex::LAYOUT];
+    let bufs_inst = [Vertex::LAYOUT, crate::props::Inst::LAYOUT];
+    s.device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+        label: Some(if blend { "city blend (one material)" } else { "city opaque (one material)" }),
+        layout: Some(&s.layout),
+        vertex: wgpu::VertexState {
+            module: &module,
+            entry_point: Some(vs),
+            buffers: if inst { &bufs_inst } else { &bufs_plain },
+            compilation_options: Default::default(),
+        },
+        fragment: Some(wgpu::FragmentState {
+            module: &module,
+            entry_point: Some("fs_main"),
+            targets: &[Some(wgpu::ColorTargetState {
+                format: post::SCENE_FORMAT,
+                blend: Some(if blend { wgpu::BlendState::ALPHA_BLENDING } else { wgpu::BlendState::REPLACE }),
+                write_mask: wgpu::ColorWrites::ALL,
+            })],
+            compilation_options: Default::default(),
+        }),
+        primitive: wgpu::PrimitiveState { topology: wgpu::PrimitiveTopology::TriangleList, cull_mode: cull, front_face: wgpu::FrontFace::Cw, ..Default::default() },
+        depth_stencil: Some(v.ds(zwrite, wgpu::CompareFunction::GreaterEqual, true, Default::default())),
+        multisample: v.ms(),
+        multiview: None,
+        cache: None,
+    })
+}
