diff --git a/mcla-rs/crates/game/src/gpuprof.rs b/mcla-rs/crates/game/src/gpuprof.rs
new file mode 100644
index 0000000..e7a461e
--- /dev/null
+++ b/mcla-rs/crates/game/src/gpuprof.rs
@@ -0,0 +1,133 @@
+//! GPU time per render pass (MCLA_GPU_TIMES=1): every pass of the frame writes a timestamp as it begins and ends,
+//! the frame's queries are read back after its submit (waiting for the GPU, so the frame rate drops a little), and
+//! every 3 seconds the log gets the frame's GPU time and the passes that took the most, by their source line.
+//! Off (no queries, no waiting) unless the variable is set and the adapter has timestamp queries.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+const QUERIES: u32 = 512;
+
+struct Prof {
+    set: wgpu::QuerySet,
+    resolve: wgpu::Buffer,
+    read: wgpu::Buffer,
+    period_ns: f32,
+    state: Mutex<State>,
+}
+
+struct State {
+    /// this frame's passes: (file, line), first query index
+    passes: Vec<(&'static str, u32, u32)>,
+    /// resolved and waiting for `collect`
+    pending: Vec<(&'static str, u32, u32)>,
+    pending_count: u32,
+    sums: HashMap<(&'static str, u32), (f64, u32)>,
+    frame_ns: f64,
+    frames: u32,
+    since: Instant,
+}
+
+static PROF: OnceLock<Prof> = OnceLock::new();
+
+/// Whether to ask the device for timestamp queries.
+pub fn wanted() -> bool {
+    std::env::var("MCLA_GPU_TIMES").map_or(false, |v| v != "0")
+}
+
+pub fn init(device: &wgpu::Device, queue: &wgpu::Queue) {
+    if !wanted() || !device.features().contains(wgpu::Features::TIMESTAMP_QUERY) {
+        if wanted() {
+            log::warn!("gpu times: the adapter has no timestamp queries");
+        }
+        return;
+    }
+    let set = device.create_query_set(&wgpu::QuerySetDescriptor { label: Some("gpu times"), ty: wgpu::QueryType::Timestamp, count: QUERIES });
+    let size = QUERIES as u64 * 8;
+    let resolve = device.create_buffer(&wgpu::BufferDescriptor { label: Some("gpu times resolve"), size, usage: wgpu::BufferUsages::QUERY_RESOLVE | wgpu::BufferUsages::COPY_SRC, mapped_at_creation: false });
+    let read = device.create_buffer(&wgpu::BufferDescriptor { label: Some("gpu times read"), size, usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST, mapped_at_creation: false });
+    let period_ns = queue.get_timestamp_period();
+    log::info!("gpu times: on ({period_ns} ns per tick)");
+    let state = State { passes: Vec::new(), pending: Vec::new(), pending_count: 0, sums: HashMap::new(), frame_ns: 0.0, frames: 0, since: Instant::now() };
+    let _ = PROF.set(Prof { set, resolve, read, period_ns, state: Mutex::new(state) });
+}
+
+/// A pass's timestamp writes (`None` when off or the frame ran out of queries).
+pub fn writes(file: &'static str, line: u32) -> Option<wgpu::RenderPassTimestampWrites<'static>> {
+    let p = PROF.get()?;
+    let mut s = p.state.lock().ok()?;
+    let first = s.passes.len() as u32 * 2;
+    if first + 2 > QUERIES {
+        return None;
+    }
+    s.passes.push((file, line, first));
+    Some(wgpu::RenderPassTimestampWrites { query_set: &p.set, beginning_of_pass_write_index: Some(first), end_of_pass_write_index: Some(first + 1) })
+}
+
+/// Before the frame's submit: the frame's queries go to the read-back buffer.
+pub fn resolve(enc: &mut wgpu::CommandEncoder) {
+    let Some(p) = PROF.get() else { return };
+    let Ok(mut s) = p.state.lock() else { return };
+    let n = s.passes.len() as u32 * 2;
+    if n == 0 {
+        return;
+    }
+    enc.resolve_query_set(&p.set, 0..n, &p.resolve, 0);
+    enc.copy_buffer_to_buffer(&p.resolve, 0, &p.read, 0, n as u64 * 8);
+    s.pending = std::mem::take(&mut s.passes);
+    s.pending_count = n;
+}
+
+/// After the frame's submit: waits for the GPU, adds the frame's pass times, and logs them now and then.
+pub fn collect(device: &wgpu::Device) {
+    let Some(p) = PROF.get() else { return };
+    let Ok(mut s) = p.state.lock() else { return };
+    if s.pending_count == 0 {
+        return;
+    }
+    let bytes = s.pending_count as u64 * 8;
+    let slice = p.read.slice(..bytes);
+    let (tx, rx) = std::sync::mpsc::channel();
+    slice.map_async(wgpu::MapMode::Read, move |r| {
+        let _ = tx.send(r);
+    });
+    let _ = device.poll(wgpu::Maintain::Wait);
+    if !matches!(rx.recv(), Ok(Ok(()))) {
+        s.pending.clear();
+        s.pending_count = 0;
+        return;
+    }
+    let ticks: Vec<u64> = slice.get_mapped_range().chunks_exact(8).map(|c| u64::from_le_bytes(c.try_into().unwrap())).collect();
+    p.read.unmap();
+    let pending = std::mem::take(&mut s.pending);
+    s.pending_count = 0;
+    let (mut lo, mut hi) = (u64::MAX, 0u64);
+    for &(file, line, first) in &pending {
+        let (b, e) = (ticks[first as usize], ticks[first as usize + 1]);
+        if b == 0 || e < b {
+            continue;
+        }
+        lo = lo.min(b);
+        hi = hi.max(e);
+        let ns = (e - b) as f64 * p.period_ns as f64;
+        let entry = s.sums.entry((file, line)).or_insert((0.0, 0));
+        entry.0 += ns;
+        entry.1 += 1;
+    }
+    if hi > lo {
+        s.frame_ns += (hi - lo) as f64 * p.period_ns as f64;
+    }
+    s.frames += 1;
+    if s.since.elapsed().as_secs_f32() >= 3.0 {
+        let frames = s.frames.max(1) as f64;
+        let mut rows: Vec<_> = s.sums.iter().map(|(&(f, l), &(ns, n))| (ns / frames / 1e6, n as f64 / frames, f, l)).collect();
+        rows.sort_by(|a, b| b.0.partial_cmp(&a.0).unwrap_or(std::cmp::Ordering::Equal));
+        let top: Vec<String> = rows.iter().take(14).map(|(ms, n, f, l)| format!("{f}:{l} {ms:.2} ms (x{n:.0})")).collect();
+        log::info!("gpu times: frame {:.2} ms over {} frames | {}", s.frame_ns / frames / 1e6, s.frames, top.join(" | "));
+        s.sums.clear();
+        s.frame_ns = 0.0;
+        s.frames = 0;
+        s.since = Instant::now();
+    }
+}
