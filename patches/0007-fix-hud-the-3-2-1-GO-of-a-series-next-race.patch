From d4c735292ef5ae265cbb0c0a8469cbb84c7ec5e8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Mon, 26 Oct 2026 19:02:59 +0000
Subject: [PATCH] fix(hud): the 3-2-1-GO of a series' next race

The splash was only cleared on a frame with the countdown above 3 or no
race. A series' next race is set up while the HUD is hidden, so the
last race's flag stayed and its countdown never came up. A countdown
that goes up now clears it.
---
 mcla-rs/crates/game/src/flash_ui.rs | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/mcla-rs/crates/game/src/flash_ui.rs b/mcla-rs/crates/game/src/flash_ui.rs
index 0e452bf..d7443a1 100644
--- a/mcla-rs/crates/game/src/flash_ui.rs
+++ b/mcla-rs/crates/game/src/flash_ui.rs
@@ -1933,6 +1933,8 @@ mod tests {
 pub struct FlashHud {
     pub movie: FlashMovie,
     countdown_shown: bool,
+    /// the race's countdown on the last drive (0 with no race)
+    countdown_last: f32,
     /// the game's splash queues (`0x82234440`): per slot, up to five waiting
     /// (text, colour, seconds), posted when the movie has freed the slot
     splash_queue: [std::collections::VecDeque<(String, i32, f32)>; 3],
@@ -1951,7 +1953,7 @@ pub const SPLASH_BOTTOM: usize = 2;
 impl FlashHud {
     pub fn load(data_dir: &str, shared: &UiShared) -> Option<FlashHud> {
         let movie = FlashMovie::load(data_dir, "resources/ui/hud/0x1f0e1cda.r27", shared)?;
-        let mut h = FlashHud { movie, countdown_shown: false, splash_queue: Default::default(), racer_found: false, camera_last: -1 };
+        let mut h = FlashHud { movie, countdown_shown: false, countdown_last: 0.0, splash_queue: Default::default(), racer_found: false, camera_last: -1 };
         // (the game drives the HUD from its start - the movie is up, hidden, long before it is first shown; driven
         // only from its first showing, its first frames were its placeholders: the race clock's "1:23.45.67.85")
         for _ in 0..30 {
@@ -2157,6 +2159,14 @@ impl FlashHud {
             p.set_global("payback_stored", Value::Int(wins));
             p.set_global("payback_level", Value::Int(needed));
         }
+        // (a countdown that went up is the next race's: a series' second race is set up with the HUD hidden - the
+        // prerace scene - so no frame with the countdown above 3 cleared the last race's splash and its 3-2-1 never
+        // came up)
+        let cd = if race.is_some() { r.countdown } else { 0.0 };
+        if cd > self.countdown_last + 0.25 {
+            self.countdown_shown = false;
+        }
+        self.countdown_last = cd;
         // the 3-2-1-GO splash: the movie animates it itself once its splash slot 3 is
         // raised (`showCountdown`, one number per 1/countdownUpdate frames)
         if race.is_some() && !r.go_only && r.countdown > 0.0 && r.countdown <= 3.0 && !self.countdown_shown {
